# Windows batch files precisam de CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts precisam de LF
*.sh text eol=lf

# Python: LF em todos os SOs
*.py text eol=lf

# Markdown, JSON, YAML: LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Dockerfile: LF
Dockerfile text eol=lf

# Binários
*.png binary
*.ico binary
*.exe binary
